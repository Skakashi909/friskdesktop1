# ================= FRISK DISCORD BOT =================
# Create a bot in the Discord Developer Portal and paste the token here.
# NEVER commit the real token to Git or send it to anyone.
FRISK_DISCORD_BOT_TOKEN=
FRISK_DISCORD_GUILD_ID=1071464253099343903
FRISK_DISCORD_TEXT_CHANNEL_ID=1552830495086350427
FRISK_DISCORD_LOG_CHANNEL_ID=1552830298478350416
FRISK_DISCORD_VC_CHANNEL_ID=1552830375330316300

# ================= OBS =================
FRISK_OBS_HOST=127.0.0.1
FRISK_OBS_PORT=4455
FRISK_OBS_PASSWORD=

# ================= TWITCH IRC =================
FRISK_TWITCH_OAUTH_TOKEN=
FRISK_TWITCH_USERNAME=
FRISK_TWITCH_CHANNEL=

# ================= VTube Studio =================
FRISK_VTS_URL=ws://127.0.0.1:8001
FRISK_VTS_TOKEN=

# ================= LIVE SCREEN =================
FRISK_LIVE_CAPTURE_FPS=30
FRISK_COWATCH_ANALYSIS_INTERVAL=2.0

# Discord voice: set to 1 to make Frisk join Frisk VC on bot startup
FRISK_DISCORD_AUTO_JOIN_VC=0
# Fully-local Discord STT uses the same Vosk model configured for desktop Frisk.
FRISK_VOSK_MODEL=
FRISK_DISCORD_STT_FALLBACK=

# SECURITY / VOICE
FRISK_DISCORD_OWNER_USER_ID=
FRISK_AUTO_DOWNLOAD_VOSK=1
FRISK_VOSK_MODEL=
FRISK_DISCORD_AUTO_JOIN_VC=0

# Optional frontier intelligence adapters (bring your own API keys; never required)
# OPENAI_API_KEY=
# FRISK_OPENAI_MODEL=gpt-5.5
# GEMINI_API_KEY=
# FRISK_GEMINI_MODEL=gemini-3.8-flash
# XAI_API_KEY=
# FRISK_XAI_MODEL=grok-4.7
# Network research is enabled by default only when a research tool is invoked; set
# the persisted network preference false to keep Frisk local/offline.

# Local speech recognition (first setup may download the model; inference stays local)
FRISK_WHISPER_ENABLED=1
FRISK_WHISPER_MODEL=small
FRISK_WHISPER_DEVICE=cpu
FRISK_WHISPER_COMPUTE=int8
FRISK_WHISPER_CPU_THREADS=4
# Set this to a local model directory to avoid re-downloading.
# FRISK_WHISPER_MODEL_PATH=E:\Frisk\models\whisper-small
# FRISK_WHISPER_CACHE=E:\Frisk\models\whisper

# Local Frisk voice. Change only this ID to change the voice.
FRISK_KOKORO_ENABLED=1
FRISK_KOKORO_VOICE=af_sarah

# V47 Public Frisk-Link (cross-network/mobile-data access)
# auto = start a Cloudflare Quick Tunnel when cloudflared is available
FRISK_PUBLIC_TUNNEL=auto
FRISK_AUTO_INSTALL_CLOUDFLARED=1
# Optional explicit path: C:\Program Files\cloudflared\cloudflared.exe
# FRISK_CLOUDFLARED_PATH=
# Optional custom/named tunnel command. Must expose local port 8765.
# FRISK_TUNNEL_COMMAND=

# V47 speech fidelity
FRISK_WHISPER_BEAM_SIZE=5
FRISK_WHISPER_BEST_OF=5
FRISK_WHISPER_VAD_MIN_SILENCE_MS=350
# FRISK_WHISPER_LANGUAGE=en
